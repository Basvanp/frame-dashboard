// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = FrameDesk
PRODUCT_DISPLAY_NAME = Frame Desk
PRODUCT_BUNDLE_IDENTIFIER = dev.framedashboard.desk
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/FrameDesk.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/FrameDesk.entitlements
// ==========================================
// Menu bar app
// ==========================================
// No Dock icon or main window: the app lives in the menu bar.
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = Frame Desk reads this week's meetings from your calendars and shows them on your TV dashboard.
INFOPLIST_KEY_NSCalendarsUsageDescription = Frame Desk reads this week's meetings from your calendars and shows them on your TV dashboard.
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
