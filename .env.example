# Copy to .env.local for development; set the same names in Vercel for production.

# Your calendars' secret iCal addresses, comma-separated.
# Google Calendar → Settings → (calendar) → Integrate calendar → "Secret address in iCal format".
# file:examples/demo.ics is a demo calendar that always has something on it.
ICS_URLS=file:examples/demo.ics

# Time zone for "today", the clock and meeting times (IANA name).
DASHBOARD_TZ=America/Monterrey

# nl, en or es. The screen is Dutch unless this is es, or the URL has ?lang=.
DASHBOARD_LOCALE=nl

# Optional override. Empty means Castricum (52.54833, 4.66944).
DASHBOARD_LAT=
DASHBOARD_LON=

# bleed: painting fills the screen by day, salon wall after 7 pm (default).
# salon: the framed-painting wall all day.
DASHBOARD_LAYOUT=bleed

# Shared secrets. Generate with: openssl rand -hex 24
# READ: baked into the TV apps' URL as ?k=…   WRITE: used only to post the weekly plan.
DASHBOARD_READ_KEY=
DASHBOARD_WRITE_KEY=

# Where weekly plans are stored. Without these, plans are files in plan/ (dev only —
# Vercel's filesystem is read-only). Vercel's Upstash integration sets KV_REST_API_* instead;
# either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used by `npm run plan:push` and `npm run shell:config`.
DASHBOARD_API=http://localhost:4321
DASHBOARD_URL=http://localhost:4321/?k=
